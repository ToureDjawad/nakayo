{
  "name": "nakayo",
  "private": true,
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm run dev -w @nakayo/server\" \"npm run dev -w @nakayo/client\"",
    "dev:client": "npm run dev -w @nakayo/client",
    "dev:server": "npm run dev -w @nakayo/server",
    "build": "npm run build -w @nakayo/client",
    "lint": "npm run lint -w @nakayo/client",
    "db:up": "docker compose up -d db",
    "db:down": "docker compose down",
    "db:migrate": "npm run migrate -w @nakayo/server",
    "test": "npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "npm run test:unit -w @nakayo/client && npm run test:unit -w @nakayo/server",
    "test:integration": "npm run test:integration -w @nakayo/server",
    "test:e2e": "playwright test"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "concurrently": "^10.0.7"
  }
}
