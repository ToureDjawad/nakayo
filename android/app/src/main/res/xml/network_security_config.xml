<?xml version="1.0" encoding="utf-8"?>
<!-- Release : HTTPS seulement, certificats système uniquement (pas ceux ajoutés par l'utilisateur). -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
