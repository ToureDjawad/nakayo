PORT=3000
DATABASE_URL=postgres://nakayo:nakayo@localhost:5432/nakayo
CLIENT_URL=http://localhost:5173

# Paiement de l'offre (US-12) : « simulation » par défaut hors production (page de paiement
# simulée sur le site), « aucun » par défaut en production tant que les fournisseurs ne sont pas branchés.
# PAIEMENT_MODE=simulation
# Secret partagé avec les fournisseurs pour signer leurs webhooks (docs/api-sprint2.md §2.4).
# PAIEMENT_WEBHOOK_SECRET=
# Versements de 500 FCFA aux testeurs (US-22) : « simulation » par défaut hors production,
# « aucun » en production tant que l'agrégateur Mobile Money n'est pas branché (les versements attendent).
# VERSEMENT_MODE=simulation

# Groupe Google des testeurs (US-13), ajouté par le développeur à son test fermé. Vide : l'adresse est donnée par l'équipe.
GROUPE_GOOGLE_TESTEURS=
